+      ptp_usb->rawdevice.device_entry.product_id == 0x4ee1) {
+    ptp_usb->rawdevice.device_entry.device_flags &= ~DEVICE_FLAG_FORCE_RESET_ON_CLOSE;
+  }
+#endif
   if (ptp_closesession(params)!=PTP_RC_OK)
     LIBMTP_ERROR("ERROR: Could not close session!\n");
